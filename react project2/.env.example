VITE_KAKAO_MAP_API_KEY=your_kakao_javascript_key_here
# 자동차 모드 경로에 쓰는 카카오모빌리티 길찾기용 REST API 키(JavaScript 키와 다름). 서버에서만 사용하므로 VITE_ 접두사를 붙이지 않습니다.
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
# 여행 코스의 관광지/문화시설/야경 데이터를 가져오는 한국관광공사 TourAPI 서비스키 (data.go.kr, "디코딩" 값으로 넣을 것)
TOUR_API_KEY=your_tour_api_service_key_here
# 추천 이유/주의사항/테마 태그를 생성하는 Gemini API 키 (aistudio.google.com/apikey, 무료 발급)
GEMINI_API_KEY=your_gemini_api_key_here
# 코스 화면 상단 날씨 배지에 쓰는 OpenWeatherMap 키 (openweathermap.org, 카드 등록 없이 무료 발급)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# 음식점·카페 영업시간을 채우는 Google Places API (New) 키.
# (console.cloud.google.com → API 및 서비스 → "Places API (New)" 사용 설정 → 사용자 인증 정보에서 API 키 발급.
#  결제 계정 연결이 필요하지만 월 $200 무료 크레딧이 있고, 결과는 PlaceCache 에 캐시되어 호출량이 적습니다.
#  비워두면 음식점·카페는 예전처럼 영업시간 없이 나옵니다.)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# 대중교통 모드 지도 경로/소요시간에 쓰는 ODsay 대중교통 길찾기 키
# (lab.odsay.com 가입 → "대중교통환승경로" 신청 → 서비스 플랫폼 "Server" 로 발급받은 키.
#  Server 키는 등록한 공인 IP 에서만 동작하므로, IP 가 바뀌면 ODsay 설정에서 갱신해야 합니다.)
ODSAY_API_KEY=your_odsay_server_api_key_here
# 여행지 카드 "지금 뜨는 중" 배지에 쓰는 네이버 검색어 트렌드(데이터랩) API 키
# (developers.naver.com/apps 에서 애플리케이션 등록 → "검색" > "데이터랩(검색어trend)" API 사용 설정)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
# 비워두면 프런트엔드가 /api 로(같은 오리진) 요청하고 Vite 프록시가 백엔드로 전달합니다.
# 백엔드에 직접 붙이려면 http://127.0.0.1:4000 처럼 전체 URL 을 지정하세요.
VITE_API_BASE_URL=
PORT=4000
# 콤마로 여러 오리진 허용 (localhost / 127.0.0.1)
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# 로그인 토큰 서명 키. NODE_ENV=production 이면 이 값이 없거나 예시 그대로면 서버가 뜨지 않습니다.
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_this_with_a_long_random_secret
# 프록시/로드밸런서 뒤에 배포할 때만 켜세요 (X-Forwarded-For 를 신뢰해 실제 클라이언트 IP 로 rate limit).
# 직접 노출된 서버에서 켜면 클라이언트가 IP 를 위조해 제한을 우회할 수 있습니다.
# TRUST_PROXY=true
DATABASE_URL="file:./server/data/dev.db"
# If Prisma fails on a Windows path with spaces, use an absolute URL like:
# DATABASE_URL="file:F:/Desktop/project-trip/react project2/server/data/dev.db"
