VITE_KAKAO_MAP_API_KEY=your_kakao_javascript_key_here
# 자동차 모드 경로에 쓰는 카카오모빌리티 길찾기용 REST API 키(JavaScript 키와 다름). 서버에서만 사용하므로 VITE_ 접두사를 붙이지 않습니다.
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
# 여행 코스의 관광지/문화시설/야경 데이터를 가져오는 한국관광공사 TourAPI 서비스키 (data.go.kr, "디코딩" 값으로 넣을 것)
TOUR_API_KEY=your_tour_api_service_key_here
# 추천 이유/주의사항/테마 태그를 생성하는 Gemini API 키 (aistudio.google.com/apikey, 무료 발급)
GEMINI_API_KEY=your_gemini_api_key_here
# 코스 화면 상단 날씨 배지에 쓰는 OpenWeatherMap 키 (openweathermap.org, 카드 등록 없이 무료 발급)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# 음식점·카페 영업시간과 코스 카드 대표 사진을 채우는 Google Places API (New) 키.
# (console.cloud.google.com → API 및 서비스 → "Places API (New)" 사용 설정 → 사용자 인증 정보에서 API 키 발급.
#  결제 계정 연결이 필요하지만 월 $200 무료 크레딧이 있고, 결과는 PlaceCache 에 캐시되어 호출량이 적습니다.
#  비워두면 음식점·카페는 영업시간과 사진 없이 나옵니다. 관광지·문화시설 사진은 TourAPI 라 영향 없습니다.)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# 대중교통 모드 지도 경로/소요시간에 쓰는 ODsay 대중교통 길찾기 키
# (lab.odsay.com 가입 → "대중교통환승경로" 신청 → 서비스 플랫폼 "Server" 로 발급받은 키.
#  Server 키는 등록한 공인 IP 에서만 동작하므로, IP 가 바뀌면 ODsay 설정에서 갱신해야 합니다.)
ODSAY_API_KEY=your_odsay_server_api_key_here
# 도보 모드 지도 경로에 쓰는 Tmap(SK 오픈API) 보행자 경로안내 API 키
# (developers.sktelecom.com 가입 → 애플리케이션 등록 → "보행자 경로안내" API 사용 설정 → App Key 발급, 무료.
#  비워두면 도보 모드는 예전처럼 장소를 직선으로 잇는 예상 동선으로만 표시됩니다.)
TMAP_API_KEY=your_tmap_appkey_here
# 여행지 카드 "지금 뜨는 중" 배지에 쓰는 네이버 검색어 트렌드(데이터랩) API 키
# (developers.naver.com/apps 에서 애플리케이션 등록 → "검색" > "데이터랩(검색어trend)" API 사용 설정)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
# 비워두면 프런트엔드가 /api 로(같은 오리진) 요청하고 Vite 프록시가 백엔드로 전달합니다.
# 백엔드에 직접 붙이려면 http://127.0.0.1:4000 처럼 전체 URL 을 지정하세요.
VITE_API_BASE_URL=
PORT=4000
# 콤마로 여러 오리진 허용 (localhost / 127.0.0.1)
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# 프록시/로드밸런서 뒤에 배포할 때만 켜세요 (X-Forwarded-For 를 신뢰해 실제 클라이언트 IP 로 rate limit).
# 직접 노출된 서버에서 켜면 클라이언트가 IP 를 위조해 제한을 우회할 수 있습니다.
# TRUST_PROXY=true

# ── Supabase ────────────────────────────────────────────────────────────
# 로그인(이메일/비밀번호 + 소셜 로그인)과 DB를 Supabase가 담당합니다. supabase.com에서
# 프로젝트를 만든 뒤 Settings → API, Settings → Database 에서 아래 값을 채우세요.
# VITE_ 접두사가 붙은 두 값은 브라우저에 노출돼도 되는 공개 값입니다.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# service_role 키는 절대 브라우저로 보내면 안 됩니다 — 서버(백엔드)에서 액세스 토큰을
# 검증할 때만 씁니다. Settings → API → service_role 에서 확인하세요.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Postgres 연결 문자열 (대시보드 상단 Connect → ORMs → Prisma 탭에서 복사).
# 평소 쿼리는 트랜잭션 모드 pooler(6543), 마이그레이션(db push)은 세션 모드(5432)를 쓴다.
# db.<ref>.supabase.co 직접 연결은 IPv6 전용이라 IPv4 환경에서 실패할 수 있어 pooler 를 쓴다.
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ── 소셜 로그인 (카카오 / 구글) ─────────────────────────────────────────
# 코드는 Supabase OAuth 로 이미 연결돼 있어서(useAuth.js 의 signInWithProvider) .env 에
# 추가로 넣을 키는 없습니다. 대신 대시보드 두 곳을 한 번씩 설정해야 버튼이 동작합니다.
#
# [1] developers.kakao.com → 내 애플리케이션 (지도/길찾기에 쓰는 앱과 같은 앱을 써도 됩니다)
#   - 제품 설정 → 카카오 로그인 → 활성화 ON
#   - 제품 설정 → 카카오 로그인 → Redirect URI 에 아래 주소 등록
#       https://<프로젝트ref>.supabase.co/auth/v1/callback
#   - 제품 설정 → 카카오 로그인 → 동의항목: 닉네임(필수), 카카오계정(이메일) 권장
#       (이메일 동의를 안 받으면 가입은 되지만 상단바에 이메일 대신 이름이 표시됩니다)
#   - 앱 설정 → 앱 키 → REST API 키   = Supabase 의 Client ID
#   - 제품 설정 → 카카오 로그인 → 보안 → Client Secret 생성 후 "사용함"으로 설정
#   - 앱 설정 → 플랫폼 → Web → 사이트 도메인에 http://localhost:5173 (배포 시 실제 도메인) 추가
#
# [2] Supabase 대시보드 → Authentication → Providers → Kakao
#   - Enable 켜고 위의 REST API 키 / Client Secret 을 붙여 넣기
#   - Authentication → URL Configuration → Redirect URLs 에 http://localhost:5173 (배포 시 실제 도메인) 추가
#
# 구글도 같은 방식입니다 (Google Cloud Console 의 OAuth 클라이언트 ID/시크릿 →
# Authentication → Providers → Google). Provider 가 꺼져 있으면 로그인 창에
# "아직 연결되지 않았어요" 메시지가 뜨니, 동작 여부는 버튼을 눌러 보면 바로 알 수 있습니다.

